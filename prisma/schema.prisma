generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  SUPER_ADMIN
  COMPANY_USER
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  TERMINATED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  INTERNSHIP
  FREELANCE
  PART_TIME
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  LOCKED
}

enum AssignmentType {
  WORK
  OFF
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  LEAVE
  SICK
  PERMISSION
  HOLIDAY
  OVERTIME
}

enum AttendanceMethod {
  GPS
  QR
  MANUAL
}

model Company {
  id              String               @id @default(cuid())
  code            String               @unique
  name            String
  logoUrl         String?
  primaryColor    String               @default("#2563EB")
  secondaryColor  String               @default("#0F172A")
  address         String?
  email           String?
  phone           String?
  timezone        String               @default("Asia/Makassar")
  currency        String               @default("IDR")
  defaultLanguage String               @default("id")
  dateFormat      String               @default("DD/MM/YYYY")
  status          CompanyStatus        @default(ACTIVE)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  memberships     Membership[]
  roles           Role[]
  branches        Branch[]
  departments     Department[]
  positions       Position[]
  employees       Employee[]
  auditLogs       AuditLog[]
  shifts          Shift[]
  schedules       Schedule[]
  assignments     ScheduleAssignment[]
  attendances     Attendance[]

  @@index([status, deletedAt])
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  fullName     String
  platformRole PlatformRole   @default(COMPANY_USER)
  isActive     Boolean        @default(true)
  locale       String         @default("id")
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  memberships  Membership[]
  loginHistory LoginHistory[]
  auditLogs    AuditLog[]     @relation("AuditActor")
}

model Role {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name        String
  isSystem    Boolean      @default(false)
  permissions Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  memberships Membership[]

  @@unique([companyId, name])
  @@index([companyId, deletedAt])
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  companyId String
  roleId    String
  status    MembershipStatus @default(ACTIVE)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, companyId])
  @@index([companyId, status])
}

model Branch {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code        String
  name        String
  address     String?
  latitude    Decimal?     @db.Decimal(10, 7)
  longitude   Decimal?     @db.Decimal(10, 7)
  radiusM     Int          @default(100)
  timezone    String       @default("Asia/Makassar")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  employees   Employee[]
  shifts      Shift[]
  attendances Attendance[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
}

model Department {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code      String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  employees Employee[]
  shifts    Shift[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
}

model Position {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code      String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
}

model Employee {
  id               String               @id @default(cuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeNumber   String
  fullName         String
  email            String?
  phone            String?
  address          String?
  birthDate        DateTime?
  joinDate         DateTime
  branchId         String?
  branch           Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  departmentId     String?
  department       Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  positionId       String?
  position         Position?            @relation(fields: [positionId], references: [id], onDelete: Restrict)
  employmentType   EmploymentType
  employmentStatus EmployeeStatus       @default(ACTIVE)
  monthlyDaysOff   Int                  @default(4)
  baseSalary       Decimal?             @db.Decimal(18, 2)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  assignments      ScheduleAssignment[]
  attendances      Attendance[]

  @@unique([companyId, employeeNumber])
  @@index([companyId, branchId, departmentId, deletedAt])
}

model Shift {
  id               String               @id @default(cuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code             String
  name             String
  startTime        String
  endTime          String
  breakMinutes     Int                  @default(60)
  lateToleranceMin Int                  @default(0)
  color            String               @default("#2563EB")
  branchId         String?
  branch           Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  departmentId     String?
  department       Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  assignments      ScheduleAssignment[]

  @@unique([companyId, code])
  @@index([companyId, branchId, departmentId, deletedAt])
}

model Schedule {
  id           String               @id @default(cuid())
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  month        DateTime
  name         String
  status       ScheduleStatus       @default(DRAFT)
  branchId     String?
  departmentId String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  publishedAt  DateTime?
  assignments  ScheduleAssignment[]

  @@unique([companyId, month, branchId, departmentId])
  @@index([companyId, status, month])
}

model ScheduleAssignment {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  scheduleId String
  schedule   Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shiftId    String?
  shift      Shift?         @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  date       DateTime
  type       AssignmentType @default(WORK)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([scheduleId, employeeId, date])
  @@index([companyId, date, employeeId])
}

model Attendance {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  workDate        DateTime
  checkInAt       DateTime?
  checkOutAt      DateTime?
  status          AttendanceStatus @default(PRESENT)
  method          AttendanceMethod @default(MANUAL)
  latitude        Decimal?         @db.Decimal(10, 7)
  longitude       Decimal?         @db.Decimal(10, 7)
  distanceM       Int?
  workMinutes     Int              @default(0)
  lateMinutes     Int              @default(0)
  overtimeMinutes Int              @default(0)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([companyId, employeeId, workDate])
  @@index([companyId, workDate, status])
  @@index([companyId, branchId, workDate])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actorUserId   String?
  actor         User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action        String
  module        String
  entityType    String?
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([companyId, module, createdAt])
  @@index([actorUserId, createdAt])
}
